{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NetX 메인 창 권한. 셸·파일 시스템 플러그인은 열지 않는다. 백엔드 명령은 앱 매니페스트(build.rs)에 등록한 것만 허용한다.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-app-info",
    "allow-environment-status",
    "allow-get-tools",
    "allow-get-recipes",
    "allow-plan-from-recipe",
    "allow-validate-plan",
    "allow-run-recipe",
    "allow-cancel-run",
    "allow-tool-status",
    "allow-install-tools"
  ]
}
