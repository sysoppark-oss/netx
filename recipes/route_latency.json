{
  "id": "route_latency",
  "icon": "📉",
  "title": "라우팅 지연 분석",
  "description": "목적지까지 가는 경로에서 어느 구간이 느리거나 끊기는지 찾는다.",
  "inputs": [
    {
      "name": "target",
      "type": "host",
      "label": "목적지",
      "example": "8.8.8.8"
    }
  ],
  "keywords": [
    "느려",
    "지연",
    "끊김",
    "끊겨",
    "핑",
    "렉",
    "라우팅",
    "경로",
    "손실"
  ],
  "parallel": true,
  "steps": [
    {
      "tool": "mtr",
      "args": [
        "-r",
        "-w",
        "-b",
        "-c",
        "10",
        "{target}"
      ],
      "reason": "홉마다 10회 측정해 손실과 지연이 시작되는 구간을 찾는다.",
      "expect": "특정 홉부터 끝까지 Loss가 이어지면 그 구간이 원인. 중간 홉만 Loss면 무시해도 된다."
    },
    {
      "tool": "ping",
      "args": [
        "-c",
        "5",
        "{target}"
      ],
      "reason": "종단 간 왕복 시간을 요약한다.",
      "expect": "평균 시간과 손실률. 손실 0%에 시간이 고르면 정상."
    }
  ]
}
