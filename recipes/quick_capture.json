{
  "id": "quick_capture",
  "icon": "👁️",
  "title": "트래픽 퀵 캡처",
  "description": "조건에 맞는 패킷을 캡처해 파일로 저장한다. 인터페이스, 프로토콜, 포트(범위 가능), 상대 주소로 좁힐 수 있다.",
  "min_level": "junior",
  "inputs": [
    {
      "name": "iface",
      "type": "iface",
      "label": "인터페이스",
      "example": "eth0",
      "default": "any",
      "source": "interfaces"
    },
    {
      "name": "proto",
      "type": "enum",
      "label": "프로토콜",
      "values": [
        "all",
        "tcp",
        "udp",
        "sctp",
        "icmp",
        "icmp6",
        "arp",
        "rarp",
        "ip",
        "ip6",
        "igmp",
        "ospf",
        "eigrp",
        "bgp",
        "rip",
        "pim",
        "vrrp",
        "hsrp",
        "stp",
        "lldp",
        "vlan",
        "pppoe",
        "mpls",
        "gre",
        "esp",
        "ah",
        "ike",
        "ipip",
        "l2tp",
        "vxlan",
        "dns",
        "dhcp",
        "http",
        "https",
        "ssh",
        "telnet",
        "ftp",
        "tftp",
        "smtp",
        "snmp",
        "ntp",
        "syslog",
        "ldap",
        "smb",
        "rdp",
        "sip",
        "radius",
        "netflow"
      ],
      "value_labels": [
        "전체",
        "TCP",
        "UDP",
        "SCTP",
        "ICMP (ping)",
        "ICMPv6",
        "ARP",
        "RARP",
        "IPv4 전체",
        "IPv6 전체",
        "IGMP (멀티캐스트)",
        "OSPF",
        "EIGRP",
        "BGP (TCP 179)",
        "RIP (UDP 520)",
        "PIM",
        "VRRP",
        "HSRP (UDP 1985)",
        "STP (스패닝 트리)",
        "LLDP",
        "VLAN 태그 (802.1Q)",
        "PPPoE",
        "MPLS",
        "GRE 터널",
        "IPsec ESP",
        "IPsec AH",
        "IPsec IKE (UDP 500/4500)",
        "IP-in-IP 터널",
        "L2TP (UDP 1701)",
        "VXLAN (UDP 4789)",
        "DNS (53)",
        "DHCP (67/68)",
        "HTTP (TCP 80)",
        "HTTPS (TCP 443)",
        "SSH (TCP 22)",
        "Telnet (TCP 23)",
        "FTP (TCP 20/21)",
        "TFTP (UDP 69)",
        "SMTP (TCP 25/587)",
        "SNMP (UDP 161/162)",
        "NTP (UDP 123)",
        "Syslog (UDP 514)",
        "LDAP (389/636)",
        "SMB (TCP 445)",
        "RDP (3389)",
        "SIP (5060/5061)",
        "RADIUS (UDP 1812/1813)",
        "NetFlow (UDP 2055)"
      ],
      "default": "all",
      "example": "tcp",
      "hint": "포트를 함께 쓸 수 있는 것은 전체, TCP, UDP, SCTP입니다. 이름에 포트가 적힌 항목은 그 포트로 고정됩니다."
    },
    {
      "name": "port",
      "type": "port_range",
      "label": "포트 또는 범위",
      "example": "21-30",
      "optional": true,
      "hint": "1~65535. 하나만(443) 또는 범위(21-30)로 적습니다. 비워 두면 모든 포트."
    },
    {
      "name": "host",
      "type": "host",
      "label": "상대 주소",
      "example": "192.168.0.50",
      "optional": true,
      "hint": "비워 두면 모든 상대."
    },
    {
      "name": "count",
      "type": "number",
      "label": "패킷 수",
      "example": "100",
      "default": "100",
      "min": 1,
      "max": 100000,
      "hint": "이 개수만큼 잡으면 끝납니다."
    }
  ],
  "keywords": [
    "캡처",
    "패킷",
    "덤프",
    "tcpdump",
    "pcap"
  ],
  "parallel": false,
  "steps": [
    {
      "tool": "tcpdump",
      "args": [
        "(인터페이스, 프로토콜, 포트, 상대 주소에 따라 조립)"
      ],
      "reason": "조건에 맞는 패킷을 정한 개수만큼 pcap 파일로 저장한다.",
      "expect": "작업 폴더에 capture-(시각).pcap이 생긴다. Wireshark로 열어 볼 수 있다. 패킷이 안 잡히면 조건에 맞는 통신이 없다는 뜻."
    }
  ]
}
