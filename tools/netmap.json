{
  "tool": "netmap",
  "title": "내부 네트워크 조사 (내장)",
  "description": "내 네트워크 대역의 장비를 찾아 주소, MAC, 열린 포트, 추정 종류를 모으고 구성도를 그린다. 기본은 TCP 연결 시도와 이웃(ARP) 목록만 쓰고, 옵션으로 핑, mDNS·UPnP, 포트 첫 응답 읽기, 넓은 포트 목록을 더한다. 관리하는 네트워크에서만 사용한다.",
  "engines": [
    "builtin"
  ],
  "risk": "caution",
  "categories": [
    "스캔",
    "구성도"
  ],
  "viz": "subway_topology",
  "options": [
    {
      "flag": "--ping",
      "type": "boolean",
      "label": "핑도 보낸다 (TCP를 다 막은 장비 찾기, 응답 시간)",
      "group": "찾기"
    },
    {
      "flag": "--mdns",
      "type": "boolean",
      "label": "mDNS·UPnP로 묻는다 (프린터·TV·IoT의 종류와 이름)",
      "group": "찾기"
    },
    {
      "flag": "--deep",
      "type": "boolean",
      "label": "포트를 넓게 본다 (13종 → 47종: 관리·프린터·NAS·카메라·DB)",
      "group": "포트"
    },
    {
      "flag": "--ports",
      "type": "port_list",
      "label": "두드릴 포트를 직접 고른다 (50개까지)",
      "group": "포트"
    },
    {
      "flag": "--banner",
      "type": "boolean",
      "label": "열린 포트의 첫 응답을 읽는다 (SSH 판, 웹 화면 제목). 장비에 접속 흔적이 남는다",
      "group": "포트",
      "risk": "caution"
    },
    {
      "flag": "--snmp",
      "type": "boolean",
      "label": "SNMP로 스위치 연결 관계를 묻는다 (설정에 커뮤니티 문자열이 있을 때, 기본)",
      "group": "연결 관계"
    },
    {
      "flag": "--no-snmp",
      "type": "boolean",
      "label": "SNMP로 묻지 않는다",
      "group": "연결 관계"
    },
    {
      "flag": "--timeout",
      "type": "number",
      "label": "응답을 기다리는 시간(밀리초)",
      "group": "제한",
      "min": 200,
      "max": 5000
    }
  ],
  "positional": [
    {
      "name": "target",
      "type": "target",
      "label": "대역 (예: 192.168.0.0/24). auto라고 적으면 내 네트워크 대역",
      "required": true,
      "min": 22
    }
  ]
}
