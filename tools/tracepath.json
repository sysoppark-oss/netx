    },
    {
      "flag": "-4",
      "type": "boolean",
      "label": "IPv4만 사용",
      "group": "대상"
    },
    {
      "flag": "-6",
      "type": "boolean",
      "label": "IPv6만 사용",
      "group": "대상"
