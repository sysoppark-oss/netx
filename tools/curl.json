{
  "tool": "curl",
  "title": "HTTP 시험 (curl)",
  "description": "웹 서버가 어떻게 응답하는지, TLS와 인증서가 정상인지 확인한다.",
  "engines": [
    "wsl",
    "builtin"
  ],
  "end_of_options": true,
  "categories": [
    "HTTP",
    "TLS",
    "L7"
  ],
  "options": [
    {
      "flag": "-I",
      "type": "boolean",
      "label": "헤더만 요청",
      "group": "요청",
      "aliases": [
        "--head"
      ]
    },
    {
      "flag": "-L",
      "type": "boolean",
      "label": "리다이렉트 따라가기",
      "group": "요청",
      "aliases": [
        "--location"
      ]
    },
    {
      "flag": "-X",
      "type": "enum",
      "label": "요청 방식",
      "group": "요청",
      "aliases": [
        "--request"
      ],
      "values": [
        "GET",
        "HEAD",
        "OPTIONS",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "risk": "caution"
    },
    {
      "flag": "-H",
      "type": "string",
      "label": "요청 헤더 추가 (예: Host: example.com)",
      "group": "요청",
      "aliases": [
        "--header"
      ],
      "deny_prefix": [
        "@"
      ]
    },
    {
      "flag": "-A",
      "type": "string",
      "label": "User-Agent 지정",
      "group": "요청",
      "aliases": [
        "--user-agent"
      ]
    },
    {
      "flag": "-e",
      "type": "string",
      "label": "Referer 지정",
      "group": "요청",
      "aliases": [
        "--referer"
      ]
    },
    {
      "flag": "-r",
      "type": "string",
      "label": "범위 요청 (예: 0-1023)",
      "group": "요청",
      "aliases": [
        "--range"
      ]
    },
    {
      "flag": "--compressed",
      "type": "boolean",
      "label": "압축 응답 요청",
      "group": "요청"
    },
    {
      "flag": "-d",
      "type": "string",
      "label": "본문 데이터 전송",
      "group": "요청",
      "aliases": [
        "--data"
      ],
      "deny_prefix": [
        "@"
      ],
      "risk": "caution"
    },
    {
      "flag": "-u",
      "type": "string",
      "label": "사용자:비밀번호 (명령 기록에 남음)",
      "group": "요청",
      "aliases": [
        "--user"
      ],
      "risk": "caution"
    },
    {
      "flag": "-v",
      "type": "boolean",
      "label": "연결·TLS 과정 상세 출력",
      "group": "출력",
      "aliases": [
        "--verbose"
      ]
    },
    {
      "flag": "-s",
      "type": "boolean",
      "label": "진행 표시 숨김",
      "group": "출력",
      "aliases": [
        "--silent"
      ]
    },
    {
      "flag": "-S",
      "type": "boolean",
      "label": "오류는 표시(-s와 함께)",
      "group": "출력",
      "aliases": [
        "--show-error"
      ]
    },
    {
      "flag": "-i",
      "type": "boolean",
      "label": "응답 헤더도 함께 출력",
      "group": "출력",
      "aliases": [
        "--include"
      ]
    },
    {
      "flag": "-f",
      "type": "boolean",
      "label": "HTTP 오류면 실패 처리",
      "group": "출력",
      "aliases": [
        "--fail"
      ]
    },
    {
      "flag": "-w",
      "type": "format",
      "label": "끝에 출력할 측정값 형식 (예: ttfb:%{time_starttransfer})",
      "group": "출력",
      "aliases": [
        "--write-out"
      ],
      "deny_prefix": [
        "@"
      ]
    },
    {
      "flag": "-o",
      "type": "path",
      "label": "응답 본문 저장(작업 폴더). /dev/null은 버리기",
      "group": "저장",
      "aliases": [
        "--output"
      ],
      "allow_values": [
        "/dev/null"
      ],
      "risk": "caution"
    },
    {
      "flag": "-O",
      "type": "boolean",
      "label": "원격 파일 이름으로 저장(작업 폴더)",
      "group": "저장",
      "aliases": [
        "--remote-name"
      ],
      "risk": "caution"
    },
    {
      "flag": "-k",
      "type": "boolean",
      "label": "인증서 오류 무시",
      "group": "TLS",
      "aliases": [
        "--insecure"
      ]
    },
    {
      "flag": "--tlsv1.2",
      "type": "boolean",
      "label": "TLS 1.2 이상 사용",
      "group": "TLS"
    },
    {
      "flag": "--tlsv1.3",
      "type": "boolean",
      "label": "TLS 1.3 이상 사용",
      "group": "TLS"
    },
    {
      "flag": "--tls-max",
      "type": "enum",
      "label": "허용할 최고 TLS 버전",
      "group": "TLS",
      "values": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    {
      "flag": "--cert-status",
      "type": "boolean",
      "label": "인증서 폐기 상태(OCSP) 확인",
      "group": "TLS"
    },
    {
      "flag": "--http1.1",
      "type": "boolean",
      "label": "HTTP/1.1 사용",
      "group": "프로토콜"
    },
    {
      "flag": "--http2",
      "type": "boolean",
      "label": "HTTP/2 사용",
      "group": "프로토콜"
    },
    {
      "flag": "--http3",
      "type": "boolean",
      "label": "HTTP/3 사용",
      "group": "프로토콜"
    },
    {
      "flag": "-4",
      "type": "boolean",
      "label": "IPv4만 사용",
      "group": "연결",
      "aliases": [
        "--ipv4"
      ]
    },
    {
      "flag": "-6",
      "type": "boolean",
      "label": "IPv6만 사용",
      "group": "연결",
      "aliases": [
        "--ipv6"
      ]
    },
    {
      "flag": "-m",
      "type": "float",
      "label": "전체 제한 시간(초)",
      "group": "제한",
      "aliases": [
        "--max-time"
      ],
      "min": 0.1,
      "max": 3600
    },
    {
      "flag": "--connect-timeout",
      "type": "float",
      "label": "연결 제한 시간(초)",
      "group": "제한",
      "min": 0.1,
      "max": 600
    },
    {
      "flag": "--retry",
      "type": "number",
      "label": "재시도 횟수",
      "group": "제한",
      "min": 0,
      "max": 10
    },
    {
      "flag": "--resolve",
      "type": "string",
      "label": "이름을 특정 주소로 고정 (호스트:포트:주소)",
      "group": "연결"
    },
    {
      "flag": "--connect-to",
      "type": "string",
      "label": "다른 서버로 연결 (호스트:포트:대상호스트:대상포트)",
      "group": "연결"
    },
    {
      "flag": "--interface",
      "type": "iface",
      "label": "보낼 인터페이스",
      "group": "연결"
    },
    {
      "flag": "--dns-servers",
      "type": "string",
      "label": "사용할 DNS 서버",
      "group": "연결"
    },
    {
      "flag": "-x",
      "type": "string",
      "label": "프록시 주소",
      "group": "연결",
      "aliases": [
        "--proxy"
      ],
      "risk": "caution"
    },
    {
      "flag": "-g",
      "type": "boolean",
      "label": "URL의 중괄호·대괄호를 그대로 사용",
      "group": "요청",
      "aliases": [
        "--globoff"
      ]
    },
    {
      "flag": "-K",
      "type": "string",
      "label": "설정 파일 읽기",
      "aliases": [
        "--config"
      ],
      "risk": "forbidden"
    },
    {
      "flag": "-T",
      "type": "string",
      "label": "파일 업로드",
      "aliases": [
        "--upload-file"
      ],
      "risk": "forbidden"
    },
    {
      "flag": "-F",
      "type": "string",
      "label": "폼 전송(파일 첨부 가능)",
      "aliases": [
        "--form"
      ],
      "risk": "forbidden"
    },
    {
      "flag": "--data-binary",
      "type": "string",
      "label": "파일 내용 그대로 전송",
      "risk": "forbidden"
    },
    {
      "flag": "--data-urlencode",
      "type": "string",
      "label": "인코딩해 전송(파일 읽기 가능)",
      "risk": "forbidden"
    },
    {
      "flag": "-D",
      "type": "string",
      "label": "응답 헤더를 파일로 저장",
      "aliases": [
        "--dump-header"
      ],
      "risk": "forbidden"
    },
    {
      "flag": "-c",
      "type": "string",
      "label": "쿠키를 파일로 저장",
      "aliases": [
        "--cookie-jar"
      ],
      "risk": "forbidden"
    },
    {
      "flag": "-b",
      "type": "string",
      "label": "쿠키 전송(파일 읽기 가능)",
      "aliases": [
        "--cookie"
      ],
      "risk": "forbidden"
    },
    {
      "flag": "--trace",
      "type": "string",
      "label": "통신 내용을 파일로 기록",
      "risk": "forbidden"
    },
    {
      "flag": "--trace-ascii",
      "type": "string",
      "label": "통신 내용을 파일로 기록",
      "risk": "forbidden"
    },
    {
      "flag": "--stderr",
      "type": "string",
      "label": "오류 출력을 파일로",
      "risk": "forbidden"
    },
    {
      "flag": "--libcurl",
      "type": "string",
      "label": "소스 코드를 파일로 저장",
      "risk": "forbidden"
    },
    {
      "flag": "--netrc-file",
      "type": "string",
      "label": "계정 파일 읽기",
      "risk": "forbidden"
    },
    {
      "flag": "-E",
      "type": "string",
      "label": "클라이언트 인증서 파일",
      "aliases": [
        "--cert"
      ],
      "risk": "forbidden"
    },
    {
      "flag": "--key",
      "type": "string",
      "label": "개인 키 파일",
      "risk": "forbidden"
    },
    {
      "flag": "--cacert",
      "type": "string",
      "label": "CA 인증서 파일",
      "risk": "forbidden"
    },
    {
      "flag": "--unix-socket",
      "type": "string",
      "label": "유닉스 소켓으로 연결",
      "risk": "forbidden"
    },
    {
      "flag": "--next",
      "type": "boolean",
      "label": "다음 요청 구분",
      "aliases": [
        "-:"
      ],
      "risk": "forbidden"
    }
  ],
  "positional": [
    {
      "name": "url",
      "type": "url",
      "label": "URL (http 또는 https)",
      "required": true
    }
  ]
}
