    {
      "flag": "+retry",
      "type": "number",
      "label": "재시도 횟수",
      "group": "제한",
      "min": 0,
      "max": 10
    },
    {
      "flag": "-t",
      "type": "enum",
      "label": "레코드 종류",
      "group": "질의",
      "values": [
        "A",
        "AAAA",
        "MX",
        "NS",
        "TXT",
        "SOA",
        "CNAME",
        "PTR",
        "SRV",
        "CAA",
        "ANY",
        "DNSKEY",
        "DS",
        "NAPTR",
        "HTTPS",
        "SVCB"
      ]
    },
    {
      "flag": "-c",
      "type": "enum",
      "label": "클래스",
      "group": "질의",
      "values": [
        "IN",
        "CH",
        "HS"
      ]
    },
    {
      "flag": "-x",
      "type": "host",
      "label": "IP 주소로 이름 찾기(역방향)",
      "group": "질의"
    },
    {
      "flag": "-q",
      "type": "host",
      "label": "질의할 이름",
      "group": "질의"
    },
    {
      "flag": "-p",
      "type": "port",
      "label": "DNS 서버 포트",
      "group": "서버"
    },
    {
      "flag": "-b",
      "type": "host",
      "label": "출발 주소",
      "group": "서버"
    },
    {
      "flag": "-4",
      "type": "boolean",
      "label": "IPv4만 사용",
      "group": "서버"
    },
    {
      "flag": "-6",
      "type": "boolean",
      "label": "IPv6만 사용",
      "group": "서버"
    },
    {
      "flag": "-f",
      "type": "string",
      "label": "파일에서 질의 목록 읽기",
      "risk": "forbidden"
    },
    {
      "flag": "-k",
      "type": "string",
      "label": "TSIG 키 파일",
      "risk": "forbidden"
    },
    {
      "flag": "-y",
      "type": "string",
      "label": "TSIG 키 직접 입력",
      "risk": "forbidden"
    }
  ],
  "positional": [
    {
      "name": "query",
      "type": "dig_arg",
      "label": "이름, 레코드 종류, @서버",
      "variadic": true
    }
  ]
}
