{
  "tool": "nmap",
  "title": "서비스 확인 (nmap)",
  "description": "대상의 열린 포트에서 어떤 서비스와 판이 돌고 있는지 알아본다. WSL에 nmap이 깔려 있어야 한다(sudo apt install nmap). 직접 관리하거나 허가받은 대상에만 쓴다.",
  "engines": [
    "wsl"
  ],
  "risk": "caution",
  "categories": [
    "포트",
    "스캔",
    "L4"
  ],
  "options": [
    {
      "flag": "-Pn",
      "type": "boolean",
      "label": "핑 확인을 건너뛰고 바로 포트를 본다",
      "group": "찾기"
    },
    {
      "flag": "-sT",
      "type": "boolean",
      "label": "TCP 연결 방식으로 확인(관리자 권한 불필요)",
      "group": "방식"
    },
    {
      "flag": "-sV",
      "type": "boolean",
      "label": "서비스와 판 알아내기",
      "group": "방식"
    },
    {
      "flag": "--version-light",
      "type": "boolean",
      "label": "판 알아내기를 가볍게",
      "group": "방식"
    },
    {
      "flag": "--version-all",
      "type": "boolean",
      "label": "판 알아내기를 끝까지",
      "group": "방식",
      "risk": "caution"
    },
    {
      "flag": "--open",
      "type": "boolean",
      "label": "열린 포트만 표시",
      "group": "출력"
    },
    {
      "flag": "--reason",
      "type": "boolean",
      "label": "그렇게 판단한 까닭 표시",
      "group": "출력"
    },
    {
      "flag": "-n",
      "type": "boolean",
      "label": "이름 변환 안 함",
      "group": "출력"
    },
    {
      "flag": "-p",
      "type": "port_list",
      "label": "확인할 포트 (예: 22,80,443)",
      "group": "대상"
    },
    {
      "flag": "--top-ports",
      "type": "number",
      "label": "많이 쓰는 포트 N개",
      "group": "대상",
      "min": 1,
      "max": 1000
    },
    {
      "flag": "--max-retries",
      "type": "number",
      "label": "재시도 횟수",
      "group": "제한",
      "min": 0,
      "max": 5
    },
    {
      "flag": "--script",
      "type": "string",
      "label": "스크립트 실행",
      "risk": "forbidden"
    },
    {
      "flag": "--script-args",
      "type": "string",
      "label": "스크립트 인자",
      "risk": "forbidden"
    },
    {
      "flag": "-sC",
      "type": "boolean",
      "label": "기본 스크립트 실행",
      "risk": "forbidden"
    },
    {
      "flag": "-A",
      "type": "boolean",
      "label": "공격적 조사(운영체제·스크립트 포함)",
      "risk": "forbidden"
    },
    {
      "flag": "-O",
      "type": "boolean",
      "label": "운영체제 추정",
      "risk": "forbidden"
    },
    {
      "flag": "-sS",
      "type": "boolean",
      "label": "SYN 스캔(관리자 권한)",
      "risk": "forbidden"
    },
    {
      "flag": "-sU",
      "type": "boolean",
      "label": "UDP 스캔(관리자 권한)",
      "risk": "forbidden"
    },
    {
      "flag": "-oN",
      "type": "string",
      "label": "결과를 파일로",
      "risk": "forbidden"
    },
    {
      "flag": "-oX",
      "type": "string",
      "label": "결과를 XML 파일로",
      "risk": "forbidden"
    },
    {
      "flag": "-oG",
      "type": "string",
      "label": "결과를 파일로",
      "risk": "forbidden"
    },
    {
      "flag": "-oA",
      "type": "string",
      "label": "결과를 파일로",
      "risk": "forbidden"
    },
    {
      "flag": "-iL",
      "type": "string",
      "label": "대상 목록을 파일에서 읽기",
      "risk": "forbidden"
    },
    {
      "flag": "--datadir",
      "type": "string",
      "label": "자료 폴더 지정",
      "risk": "forbidden"
    },
    {
      "flag": "--proxies",
      "type": "string",
      "label": "프록시 경유",
      "risk": "forbidden"
    },
    {
      "flag": "-D",
      "type": "string",
      "label": "미끼 주소 섞기",
      "risk": "forbidden"
    },
    {
      "flag": "-S",
      "type": "string",
      "label": "출발 주소 속이기",
      "risk": "forbidden"
    },
    {
      "flag": "--spoof-mac",
      "type": "string",
      "label": "MAC 주소 속이기",
      "risk": "forbidden"
    },
    {
      "flag": "--resume",
      "type": "string",
      "label": "이어서 하기",
      "risk": "forbidden"
    },
    {
      "flag": "-e",
      "type": "string",
      "label": "인터페이스 지정",
      "risk": "forbidden"
    }
  ],
  "positional": [
    {
      "name": "target",
      "type": "scan_host",
      "label": "대상 (주소 또는 이름)",
      "required": true
    }
  ]
}
